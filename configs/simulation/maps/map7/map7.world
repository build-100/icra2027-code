include "floorplan.inc"

name                    "Navigation-2D Tutorial"
interval_sim            100
quit_time                 0
resolution                0.025
show_clock                0
show_clock_interval     100
threads                 2

# Load an environment bitmap
floorplan
( 
  name "tutorial"
  # 1382 * 664 pixels
  bitmap "map7.png"
  # size in meters, should be consistent with yaml file
  # 0.1 m/pixel
  size [138.2 66.4 2.000]
  # where the center of the floor plan locates in the world frame
  pose [0.000 0.000 0.000 0.000]
)

# Static map geometry only. Robot deployment belongs to an execution scenario.
